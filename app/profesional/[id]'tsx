import React, { useState } from 'react';
import { View, Text, StyleSheet, ScrollView, TouchableOpacity, Image, FlatList, Share } from 'react-native';
import { useRouter, useLocalSearchParams } from 'expo-router';
import { LinearGradient } from 'expo-linear-gradient';
import { Colors } from '@/constants/Colors';
import { Spacing, Radius, Shadow, Typography } from '@/constants/Typography';
import { professionals } from '@/data/professionals';
import { getReviewsByProfessional } from '@/data/reviews';
import { Button } from '@/components/Button';
import { Rating } from '@/components/Rating';
import { Badge } from '@/components/Badge';
import { ReviewCard } from '@/components/ReviewCard';
import { Header } from '@/components/Header';
import { useStore } from '@/store/useStore';
import { BadgeCheck, MapPin, Clock, Globe, Heart, Share2, MessageCircle, Phone, Calendar, ChevronRight, Star } from 'lucide-react-native';

export default function ProfessionalProfileScreen() {
  const router = useRouter();
  const { id } = useLocalSearchParams<{ id: string }>();
  const pro = professionals.find((p) => p.id === id);
  const favorites = useStore((s) => s.favorites);
  const toggleFavorite = useStore((s) => s.toggleFavorite);
  const isFav = favorites.includes(id || '');
  const [activeTab, setActiveTab] = useState<'services' | 'portfolio' | 'reviews' | 'about'>('services');
  const reviews = getReviewsByProfessional(id || '');

  if (!pro) {
    return (
      <View style={styles.container}>
        <Text>Professional not found</Text>
      </View>
    );
  }

  const handleShare = async () => {
    try {
      await Share.share({ message: `Check out ${pro.name} on Linkly!` });
    } catch {}
  };

  return (
    <View style={styles.container}>
      <ScrollView showsVerticalScrollIndicator={false}>
        <View style={styles.coverWrap}>
          <Image source={{ uri: pro.coverImage }} style={styles.coverImage} />
          <LinearGradient colors={['transparent', 'rgba(0,0,0,0.3)']} style={styles.coverOverlay} />
          <View style={styles.coverActions}>
            <TouchableOpacity style={styles.iconBtn} onPress={() => router.back()}>
              <ChevronRight size={20} color={Colors.white} style={{ transform: [{ rotate: '180deg' }] }} />
            </TouchableOpacity>
            <View style={styles.coverActionsRight}>
              <TouchableOpacity style={styles.iconBtn} onPress={handleShare}>
                <Share2 size={18} color={Colors.white} />
              </TouchableOpacity>
              <TouchableOpacity style={styles.iconBtn} onPress={() => toggleFavorite(pro.id)}>
                <Heart size={18} color={isFav ? Colors.danger : Colors.white} fill={isFav ? Colors.danger : 'transparent'} />
              </TouchableOpacity>
            </View>
          </View>
        </View>

        <View style={styles.profileBody}>
          <View style={styles.avatarRow}>
            <Image source={{ uri: pro.avatar }} style={styles.avatar} />
            <View style={{ flex: 1 }}>
              <View style={styles.nameRow}>
                <Text style={styles.name}>{pro.name}</Text>
                {pro.isVerified && <BadgeCheck size={20} color={Colors.primary} fill={Colors.primary} />}
              </View>
              <Text style={styles.category}>{pro.category}</Text>
              <View style={styles.metaRow}>
                <Rating value={pro.rating} size={13} showValue reviewCount={pro.reviewCount} />
                <View style={styles.dotSep} />
                <Clock size={12} color={Colors.textSecondary} />
                <Text style={styles.metaText}>{pro.experience}</Text>
              </View>
            </View>
          </View>

          <View style={styles.badgeRow}>
            {pro.badges.map((b) => (
              <Badge key={b} label={b} variant="primary" size="sm" />
            ))}
          </View>

          <View style={styles.infoCards}>
            <View style={styles.infoCard}>
              <MapPin size={16} color={Colors.primary} />
              <Text style={styles.infoLabel}>Distance</Text>
              <Text style={styles.infoValue}>{pro.distance}</Text>
            </View>
            <View style={styles.infoCard}>
              <Star size={16} color={Colors.orange} fill={Colors.orange} strokeWidth={0} />
              <Text style={styles.infoLabel}>Rating</Text>
              <Text style={styles.infoValue}>{pro.rating}</Text>
            </View>
            <View style={styles.infoCard}>
              <Globe size={16} color={Colors.primary} />
              <Text style={styles.infoLabel}>Languages</Text>
              <Text style={styles.infoValue}>{pro.languages.length}</Text>
            </View>
          </View>

          <View style={styles.tabsRow}>
            {[
              { key: 'services', label: 'Services' },
              { key: 'portfolio', label: 'Portfolio' },
              { key: 'reviews', label: 'Reviews' },
              { key: 'about', label: 'About' },
            ].map((tab) => (
              <TouchableOpacity
                key={tab.key}
                style={[styles.tab, activeTab === tab.key && styles.tabActive]}
                onPress={() => setActiveTab(tab.key as any)}
              >
                <Text style={[styles.tabText, activeTab === tab.key && styles.tabTextActive]}>{tab.label}</Text>
              </TouchableOpacity>
            ))}
          </View>

          {activeTab === 'services' && (
            <View style={styles.tabContent}>
              {pro.services.map((s) => (
                <TouchableOpacity key={s.id} style={styles.serviceItem} onPress={() => router.push(`/booking/${pro.id}?serviceId=${s.id}`)}>
                  <View style={{ flex: 1 }}>
                    <Text style={styles.serviceName}>{s.name}</Text>
                    <Text style={styles.serviceDesc} numberOfLines={1}>{s.description}</Text>
                    <View style={styles.serviceMeta}>
                      <Clock size={12} color={Colors.textSecondary} />
                      <Text style={styles.serviceDuration}>{s.duration} min</Text>
                    </View>
                  </View>
                  <View style={styles.serviceRight}>
                    <Text style={styles.servicePrice}>${s.price}</Text>
                    <ChevronRight size={18} color={Colors.primary} />
                  </View>
                </TouchableOpacity>
              ))}
            </View>
          )}

          {activeTab === 'portfolio' && (
            <View style={styles.tabContent}>
              <View style={styles.portfolioGrid}>
                {pro.portfolio.map((item) => (
                  <View key={item.id} style={styles.portfolioItem}>
                    <Image source={{ uri: item.image }} style={styles.portfolioImage} />
                    <Text style={styles.portfolioTitle}>{item.title}</Text>
                  </View>
                ))}
              </View>
              <Text style={styles.sectionLabel}>Certificates</Text>
              {pro.certificates.map((c) => (
                <View key={c.id} style={styles.certItem}>
                  <View style={styles.certIcon}>
                    <BadgeCheck size={20} color={Colors.primary} fill={Colors.primary} />
                  </View>
                  <View style={{ flex: 1 }}>
                    <Text style={styles.certTitle}>{c.title}</Text>
                    <Text style={styles.certIssuer}>{c.issuer} - {c.year}</Text>
                  </View>
                </View>
              ))}
            </View>
          )}

          {activeTab === 'reviews' && (
            <View style={styles.tabContent}>
              <View style={styles.reviewSummary}>
                <Text style={styles.bigRating}>{pro.rating}</Text>
                <View>
                  <Rating value={pro.rating} size={16} showValue={false} />
                  <Text style={styles.reviewCount}>{pro.reviewCount} reviews</Text>
                </View>
              </View>
              <Button title="Write a Review" variant="outline" fullWidth size="md" style={{ marginBottom: 16 }} onPress={() => router.push('/reviews')} />
              {reviews.map((rev) => (
                <ReviewCard key={rev.id} review={rev} style={{ marginBottom: 12 }} />
              ))}
            </View>
          )}

          {activeTab === 'about' && (
            <View style={styles.tabContent}>
              <Text style={styles.aboutText}>{pro.bio}</Text>
              <Text style={styles.sectionLabel}>Location</Text>
              <View style={styles.locationRow}>
                <MapPin size={16} color={Colors.primary} />
                <Text style={styles.locationText}>{pro.location}, {pro.city}</Text>
              </View>
              <Text style={styles.sectionLabel}>Languages</Text>
              <View style={styles.langRow}>
                {pro.languages.map((l) => (
                  <Badge key={l} label={l} variant="neutral" />
                ))}
              </View>
              <Text style={styles.sectionLabel}>Working Hours</Text>
              {Object.entries(pro.workingHours).map(([day, hours]) => (
                <View key={day} style={styles.hoursRow}>
                  <Text style={styles.hoursDay}>{day.charAt(0).toUpperCase() + day.slice(1)}</Text>
                  <Text style={styles.hoursTime}>
                    {hours.isOpen ? `${hours.open} - ${hours.close}` : 'Closed'}
                  </Text>
                </View>
              ))}
            </View>
          )}

          <View style={{ height: 100 }} />
        </View>
      </ScrollView>

      <View style={styles.bottomBar}>
        <TouchableOpacity style={styles.bottomIconBtn} onPress={() => router.push(`/chat/${pro.id}`)}>
          <MessageCircle size={22} color={Colors.primary} />
          <Text style={styles.bottomIconLabel}>Chat</Text>
        </TouchableOpacity>
        <TouchableOpacity style={styles.bottomIconBtn}>
          <Phone size={22} color={Colors.primary} />
          <Text style={styles.bottomIconLabel}>Call</Text>
        </TouchableOpacity>
        <Button title="Book Now" onPress={() => router.push(`/booking/${pro.id}`)} size="lg" style={{ flex: 1 }} />
      </View>
    </View>
  );
}

